# 日常使用：Key 在应用「设置」里填，写进 data/providers.json。
# 下面的 *_API_KEY 只用于 CI / 服务端部署时以环境变量注入，优先级低于设置页。
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=

# 模型与端点（可选；设置页里也能改）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.6

# 服务
PORT=8787
# 浏览器用 /api/session 换短期令牌；这个值是服务间调用/CI 用的，不要打进前端
API_ACCESS_TOKEN=
SESSION_SECRET=
SESSION_TTL_MS=3600000

# 存储：sqlite | redis | memory（sqlite 原生模块不可用时自动降级 memory）
CACHE_DRIVER=sqlite
CACHE_DB_PATH=./data/cache.db
# 设置页保存的 Key 落在哪里
PROVIDERS_DB_PATH=./data/providers.json

# 限流
PER_CLIENT_DAILY=20
PER_IP_DAILY=60
# 0 = 不限制 token
GLOBAL_DAILY_TOKENS=0
MIN_INTERVAL_MS=3000
# 兜底 provider；留空 = 与主模型相同
FALLBACK_PROVIDER=
